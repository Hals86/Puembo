---
interface Props {
    phoneNumber: string;
    message?: string;
}

const {
    phoneNumber,
    message = "Hola, me gustaría recibir más información sobre los locales comerciales en Puembo.",
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float group"
    onclick="
        event.preventDefault();
        dataLayer.push({event: 'whatsapp_click'});
        setTimeout(() => {
            window.open(this.href, '_blank');
        }, 300);
    "
>
    <!-- Notification Badge -->
    <span class="notification-badge">1</span>

    <!-- Icon Container -->
    <div class="icon-container">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="whatsapp-svg"
            fill="currentColor"
        >
            <path
                d="M12.01 2.01c-5.52 0-9.99 4.47-9.99 9.99 0 1.77.46 3.42 1.25 4.86l-1.33 4.88 5.01-1.31c1.4.75 3 1.17 4.69 1.17a9.99 9.99 0 0 0 10.02-9.99c0-5.52-4.47-9.99-9.99-9.99m6.41 14.16c-.26.74-1.52 1.41-2.09 1.48-.56.07-1.11.13-3.66-.88-3.26-1.29-5.36-4.6-5.52-4.83-.16-.22-1.33-1.78-1.33-3.39 0-1.61.84-2.4 1.14-2.73.3-.33.65-.41.87-.41s.44 0 .63.01c.21.01.49-.08.76.58.28.66.95 2.33 1.03 2.5.08.16.14.36.03.58-.11.21-.16.36-.33.55s-.35.4-.5.58c-.16.18-.34.38-.15.71.19.33.86 1.42 1.84 2.3.83.74 1.52 1.22 1.84 1.42.33.19.52.16.71-.06.19-.22.81-.94 1.03-1.26.22-.32.44-.27.74-.16.3.11 1.91.9 2.24 1.06s.55.25.63.38c.08.14.08.79-.18 1.53Z"
            ></path>
        </svg>
    </div>

    <!-- Label -->
    <div class="label-container">
        <span class="label-text">¿Necesitas ayuda?</span>
        <span class="sub-label-text">Chatea con nosotros</span>
    </div>
</a>
