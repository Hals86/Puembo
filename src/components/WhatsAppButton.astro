---
interface Props {
    phoneNumber: string;
    message?: string;
}

const { 
    phoneNumber, 
    message = "Hola, me gustaría recibir más información sobre los locales comerciales en Puembo." 
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float group"
    aria-label="Contactar por WhatsApp"
>
    <!-- Notification Badge -->
    <span class="notification-badge">1</span>
    
    <!-- Icon Container -->
    <div class="icon-container">
        <svg 
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            class="whatsapp-svg"
            fill="currentColor"
        >
            <path d="M12.01 2.01c-5.52 0-9.99 4.47-9.99 9.99 0 1.77.46 3.42 1.25 4.86l-1.33 4.88 5.01-1.31c1.4.75 3 1.17 4.69 1.17a9.99 9.99 0 0 0 10.02-9.99c0-5.52-4.47-9.99-9.99-9.99m6.41 14.16c-.26.74-1.52 1.41-2.09 1.48-.56.07-1.11.13-3.66-.88-3.26-1.29-5.36-4.6-5.52-4.83-.16-.22-1.33-1.78-1.33-3.39 0-1.61.84-2.4 1.14-2.73.3-.33.65-.41.87-.41s.44 0 .63.01c.21.01.49-.08.76.58.28.66.95 2.33 1.03 2.5.08.16.14.36.03.58-.11.21-.16.36-.33.55s-.35.4-.5.58c-.16.18-.34.38-.15.71.19.33.86 1.42 1.84 2.3.83.74 1.52 1.22 1.84 1.42.33.19.52.16.71-.06.19-.22.81-.94 1.03-1.26.22-.32.44-.27.74-.16.3.11 1.91.9 2.24 1.06s.55.25.63.38c.08.14.08.79-.18 1.53Z" />
        </svg>
    </div>

    <!-- Label -->
    <div class="label-container">
        <span class="label-text">¿Necesitas ayuda?</span>
        <span class="sub-label-text">Chatea con nosotros</span>
    </div>
</a>

<style>
    .whatsapp-float {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 20px 8px 8px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 100px;
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.2),
                    0 0 20px rgba(37, 211, 102, 0.1);
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        font-family: system-ui, -apple-system, sans-serif;
    }

    .icon-container {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        position: relative;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
        transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .whatsapp-svg {
        width: 26px;
        height: 26px;
    }

    .notification-badge {
        position: absolute;
        top: -2px;
        left: 40px;
        background: #ff4b4b;
        color: white;
        font-size: 10px;
        font-weight: 800;
        min-width: 18px;
        height: 18px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        z-index: 10;
        animation: bounce 2s infinite;
    }

    .label-container {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .label-text {
        font-size: 13px;
        font-weight: 700;
        color: #1f2937;
    }

    .sub-label-text {
        font-size: 11px;
        color: #6b7280;
    }

    /* Hover Effects */
    .whatsapp-float:hover {
        transform: translateY(-5px) scale(1.02);
        background: white;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.25),
                    0 0 25px rgba(37, 211, 102, 0.2);
    }

    .whatsapp-float:hover .icon-container {
        transform: rotate(10deg);
    }

    /* Animations */
    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-5px); }
        60% { transform: translateY(-3px); }
    }

    @keyframes pulse-ring {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(37, 211, 102, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    }

    .icon-container::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: inherit;
        border-radius: inherit;
        z-index: -1;
        animation: pulse-ring 2s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;
    }

    /* Entrance Animation */
    .whatsapp-float {
        animation: slideUp 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        opacity: 0;
    }

    @keyframes slideUp {
        from {
            transform: translateY(100px) scale(0.8);
            opacity: 0;
        }
        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    /* Mobile Styles */
    @media (max-width: 640px) {
        .whatsapp-float {
            padding: 6px;
            right: 20px;
            bottom: 20px;
            gap: 0;
        }

        .label-container {
            width: 0;
            overflow: hidden;
            opacity: 0;
            transition: all 0.3s ease;
        }
        
        /* Show labels on mobile if expanded or keep it minimal */
        .whatsapp-float:active .label-container {
             /* Optional mobile interaction */
        }
    }
</style>
