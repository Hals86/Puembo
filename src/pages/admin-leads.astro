---
import Layout from "../layouts/Layout.astro";
import { db, Lead, desc } from "astro:db";

// 🔐 SEGURIDAD: Protección por contraseña maestra
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;
const isDev = import.meta.env.DEV;

// Si no hay contraseña configurada en producción, bloqueamos por seguridad
if (!ADMIN_PASSWORD && !isDev) {
    return Astro.redirect("/");
}

let authorized = false;
const cookiePassword = Astro.cookies.get("admin_auth")?.value;

// Verificar si viene el password por POST (login)
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const password = formData.get("password");
    if (password === ADMIN_PASSWORD) {
        Astro.cookies.set("admin_auth", ADMIN_PASSWORD, {
            path: "/",
            httpOnly: true,
            secure: true,
        });
        authorized = true;
    }
} else if (cookiePassword === ADMIN_PASSWORD) {
    authorized = true;
}

// Datos solo si está autorizado
const leads = authorized
    ? await db.select().from(Lead).orderBy(desc(Lead.createdAt))
    : [];

const SITE_TITLE = "Panel de Administración | Leads";
const SITE_DESCRIPTION =
    "Visualización de prospectos de Plaza Comercial Puembo";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} noindex={true}>
    <main class="bg-gray-50 min-h-screen py-12">
        <div class="max-w-6xl mx-auto px-6">
            {
                !authorized ? (
                    <div class="max-w-md mx-auto bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
                        <h1 class="text-2xl font-bold mb-6 text-center">
                            Acceso Restringido
                        </h1>
                        <form method="POST" class="space-y-4">
                            <div>
                                <label
                                    for="password"
                                    class="block text-sm font-semibold mb-2"
                                >
                                    Contraseña Maestra
                                </label>
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    class="w-full h-12 px-4 rounded-lg border-gray-200 focus:ring-primary focus:border-primary"
                                    required
                                />
                            </div>
                            <button
                                type="submit"
                                class="w-full h-12 bg-primary text-white font-bold rounded-lg hover:bg-blue-700 transition-colors"
                            >
                                Entrar al Panel
                            </button>
                        </form>
                        {Astro.request.method === "POST" && !authorized && (
                            <p class="text-red-500 text-sm mt-4 text-center">
                                Contraseña incorrecta
                            </p>
                        )}
                    </div>
                ) : (
                    <>
                        {/* Contenido original del admin */}
                        <div class="flex justify-between items-center mb-8">
                            <div>
                                <h1 class="text-3xl font-bold text-gray-900">
                                    Prospectos Recibidos
                                </h1>
                                <p class="text-gray-600">
                                    Total: {leads.length} interesados
                                </p>
                            </div>
                            <a
                                href="/"
                                class="text-primary hover:underline flex items-center gap-2"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="m15 18-6-6 6-6" />
                                </svg>
                                Volver al sitio
                            </a>
                        </div>

                        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-100 border-b border-gray-200 text-sm font-semibold text-gray-700 uppercase tracking-wider">
                                            <th class="px-6 py-4">Fecha</th>
                                            <th class="px-6 py-4">
                                                Negocio / Empresa
                                            </th>
                                            <th class="px-6 py-4">Giro</th>
                                            <th class="px-6 py-4">
                                                Presupuesto
                                            </th>
                                            <th class="px-6 py-4">WhatsApp</th>
                                            <th class="px-6 py-4">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200">
                                        {leads.length === 0 ? (
                                            <tr>
                                                <td
                                                    colspan="6"
                                                    class="px-6 py-12 text-center text-gray-500 italic"
                                                >
                                                    No hay prospectos
                                                    registrados todavía.
                                                </td>
                                            </tr>
                                        ) : (
                                            leads.map((lead) => (
                                                <tr class="hover:bg-gray-50 transition-colors">
                                                    <td class="px-6 py-4 text-sm text-gray-600">
                                                        {new Date(
                                                            lead.createdAt,
                                                        ).toLocaleDateString(
                                                            "es-EC",
                                                            {
                                                                day: "2-digit",
                                                                month: "short",
                                                                hour: "2-digit",
                                                                minute: "2-digit",
                                                            },
                                                        )}
                                                    </td>
                                                    <td class="px-6 py-4 font-medium text-gray-900">
                                                        {lead.company}
                                                    </td>
                                                    <td class="px-6 py-4 text-sm text-gray-600">
                                                        {lead.businessType}
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <span
                                                            class={`px-3 py-1 rounded-full text-xs font-bold ${
                                                                lead.budget.includes(
                                                                    "Mayor",
                                                                )
                                                                    ? "bg-green-100 text-green-700"
                                                                    : lead.budget.includes(
                                                                            "500-700",
                                                                        )
                                                                      ? "bg-blue-100 text-blue-700"
                                                                      : "bg-gray-100 text-gray-700"
                                                            }`}
                                                        >
                                                            {lead.budget}
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-sm text-gray-600">
                                                        {lead.whatsapp}
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <a
                                                            href={`https://wa.me/593${lead.whatsapp.startsWith("0") ? lead.whatsapp.substring(1) : lead.whatsapp}`}
                                                            target="_blank"
                                                            class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-bold transition-all shadow-sm hover:shadow-md"
                                                        >
                                                            <svg
                                                                xmlns="http://www.w3.org/2000/svg"
                                                                width="16"
                                                                height="16"
                                                                fill="currentColor"
                                                                viewBox="0 0 16 16"
                                                            >
                                                                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z" />
                                                            </svg>
                                                            Contactar
                                                        </a>
                                                    </td>
                                                </tr>
                                            ))
                                        )}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </>
                )
            }
        </div>
    </main>
</Layout>
